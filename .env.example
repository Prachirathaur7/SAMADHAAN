# Root Express/MongoDB service
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/samadhaan
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# GIS map frontend calls the separately hosted Node API.
# Leave blank when frontend and API share an origin locally.
VITE_API_BASE_URL=

# PostgreSQL used by the GIS map API (separate from the legacy Mongo service).
DATABASE_URL=postgresql://postgres:password@localhost:5432/samadhaan

# Node API: address of the separately deployed Python AI service
AI_ENGINE_URL=https://your-ai-service.example.com

# Hugging Face Inference Providers token with Inference Providers permission
# Leave empty to use the documented rules-based fallback for text analysis.
HF_TOKEN=
SAMADHAAN_CLASSIFIER_MODEL=MoritzLaurer/ModernBERT-large-zeroshot-v2.0
SAMADHAAN_IMAGE_MODEL=punchnami/resnet50-pothole-classification
HF_INFERENCE_TIMEOUT_SECONDS=18
AI_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
